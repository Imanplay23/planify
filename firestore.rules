rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada documento guarda un campo userId. Solo su dueño puede leerlo,
    // editarlo o borrarlo; para crear uno nuevo, el userId que se manda
    // tiene que ser el del usuario autenticado (no se puede crear "a nombre"
    // de otro).

    match /activities/{activityId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /taskLists/{listId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
